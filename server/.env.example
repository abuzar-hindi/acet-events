# ============================================================
# ACET Dandiya Celebration — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# Never commit the actual .env file to version control.

# ── MongoDB ──────────────────────────────────────────────────
# Local: mongodb://localhost:27017/acet_dandiya
# Cloud: mongodb+srv://username:password@cluster.mongodb.net/acet_dandiya
MONGO_URI=mongodb://localhost:27017/acet_dandiya

# ── Server ───────────────────────────────────────────────────
PORT=5000

# ── Event Details ─────────────────────────────────────────────
EVENT_DATE=October 22, 2026
EVENT_TIME=7:00 PM onwards
EVENT_VENUE=ACET College Auditorium & Ground, Aligarh

# ── CORS ─────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173

# ── Organizer PIN (legacy, unused) ───────────────────────────
ORGANIZER_PIN=

# ── Add Member Password ───────────────────────────────────────
# Required to add new faculty members via the organizer menu.
# IMPORTANT: Change this before deploying to production.
# Never expose this value in frontend code or API responses.
ADD_MEMBER_PASSWORD=acet_ca_26
